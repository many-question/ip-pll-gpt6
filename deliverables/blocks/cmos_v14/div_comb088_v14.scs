include "rtcomb_v13.scs"
simulator lang=spectre
// Isolate first TSPC output from the three clock-gate loads of the next stage.
// Only a /4 proof cell: no mode control, reset or keeper is claimed.
subckt div_comb088_v14 (clk q1 out vdd vss)
X0 (q0 clk q0 vdd vss) rtcomb_ff_v13 scale=1
XB0 (q0 qb0 vdd vss) pll_inv wn=0.88u wp=0.22u
XB1 (qb0 q1 vdd vss) pll_inv wn=.5u wp=2u
X1 (q2 q1 q2 vdd vss) pll_tspc_inv
XB (q2 out vdd vss) pll_inv wn=2u wp=5u
ends div_comb088_v14
