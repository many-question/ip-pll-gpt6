simulator lang=spectre
global 0
// Measurement calibration only; no PLL performance is represented by this RC.
simulatorOptions options temp=27 reltol=1e-5 vabstol=1e-7 iabstol=1e-13
VI (inp 0) vsource type=sine dc=0.6 ampl=0.5 freq=984M
R (inp out) resistor r=1k
C (out 0) capacitor c=20f
pss pss fund=4M harms=4095 maxacfreq=1T tstab=5n maxstep=250f method=gear2only tstabmethod=gear2only errpreset=conservative maxperiods=10 saveinit=yes
pn pnoise start=10k stop=492M dec=20 pnoisemethod=fullspectrum noisetype=sampled measurement=[edge] sampleratio=246 maxsideband=4095
edge jitterevent trigger=[out] triggerthresh=0.6 triggernum=1 triggerdir=rise target=[out] jittercal=[Jee]
save inp out
saveOptions options save=selected
