CL (out 0) capacitor c=10f
// lcm(24MHz reference, RF/8,RF/12) =>250ns;246 output edges.
pss pss fund=4M harms=4095 tstart=3u tstab=1u skipdc=yes readic="core_pulsetrip_settled_tt.ic" maxstep=1p method=traponly tstabmethod=traponly errpreset=conservative maxperiods=10 saveinit=yes writefinal="__FINAL_STATE__" writepss="__PERIODIC_STATE__"
pn pnoise values=[10k 100k 1M 10M 100M 491.99M] pnoisemethod=fullspectrum noisetype=sampled measurement=[edge] sampleratio=246 maxsideband=4095
edge jitterevent trigger=[out] triggerthresh=0.6 triggernum=1 triggerdir=rise target=[out] jittercal=[Jee]
save ref out XP.vp XP.vn XP.ctrl XP.vc1 XP.refb XP.hp XP.hn XP.pulse XP.clk XP.q1 XP.data XP.acqclk XP.XD.d8 XP.XD.d12 XP.preset VDD:p XP.VVCO:p XP.VRX:p XP.VRT:p
